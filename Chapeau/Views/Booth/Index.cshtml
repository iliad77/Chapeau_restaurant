@model List<Chapeau.Models.Booth>
@using Chapeau.Models.Enums;

@{
    ViewData["Title"] = "Booth List";
}

<h1>Booth List</h1>

@if (ViewBag.Message != null)
{
    <p style="color:red;">@ViewBag.Message</p>
}

<a href="/Booth/Create">
    <button type="button">Create Booth</button>
</a>

<br />
<br />

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Booth Number</th>
            <th>Seats</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var booth in Model)
            {
                <tr>
                    <td>@booth.booth_Id</td>
                    <td>@booth.booth_num</td>
                    <td>@booth.seats</td>
                    <td>@booth.booth_status</td>
                    <td>
                        <a href="/Booth/detail/@booth.booth_Id">
                            <button type="button">Details</button>
                        </a>

                        <a href="/Booth/Edit/@booth.booth_Id">
                            <button type="button">Edit</button>
                        </a>

                        <a href="/booth/Delete/@booth.booth_Id">
                            <button type="button">Delete</button>
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">No booths found.</td>
            </tr>
        }
    </tbody>
</table>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Restaurant Hall: Select a Table</h2>

    </div>

    <div class="row">
        @foreach (var booth in Model)
        {
            var isOccupied = booth.booth_status == BoothStatus.Occupied; ;
            var statusClass = isOccupied ? "border-danger" : "border-success";
            var bgClass = isOccupied ? "bg-light text-danger" : "bg-light text-success";

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card shadow-sm h-100 @statusClass">
                    <div class="card-header text-center fw-bold @bgClass">
                        Table # @booth.booth_num
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between text-center">
                        <p class="card-text text-muted mb-3">
                            <i class="bi bi-people-fill"></i> Seats: @booth.seats <br />
                            Status: <strong>@booth.booth_status</strong>
                        </p>

                        <form asp-controller="Order" asp-action="StartOrder" method="post">
                            <input type="hidden" name="boothId" value="@booth.booth_Id" />

                            <input type="hidden" name="staffId" value="0" />

                            <button type="submit" class="btn @(isOccupied ? "btn-outline-danger" : "btn-success") w-100">
                                @(isOccupied ? "View Order" : "New Order")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
