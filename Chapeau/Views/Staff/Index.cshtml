@model List<Chapeau.Models.User>
@{
    ViewData["Title"] = "staff";
}

<h1>This is staff page</h1>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>password</th>
            <th>Role</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var staff in Model)
            {
                <tr>
                    <td>@staff.Id</td>
                    <td>@staff.Username</td>
                    <td>@staff.First_name</td>
                    <td>@staff.Last_name</td>
                    <td>@staff.Email</td>
                    <td>@staff.PhoneNum</td>
                    <td>@staff.Password</td>
                    <td>@staff.Role</td>
                    <td>
                        @if (staff.Status)
                        {
                            <span>Active</span>
                        }
                        else
                        {
                            <span>Inactive</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">No staff found.</td>
            </tr>
        }
    </tbody>
</table>
<a href="/Staff/SignUp">
    <button type="button">Sign up</button>
</a>

<a href="/Staff/SignIn">
    <button type="button">Sign In</button>
</a>