@using Chapeau.Models.Enums
@model List<Chapeau.ViewModels.RestaurantViewModel>
@{
    ViewData["Title"] = "RestaurantOverview";
}

<h1>RestaurantOverview</h1>

<p>Filter by status:</p>

<div class="d-flex gap-2 mb-3">
    <a href="/Staff/RestaurantOverview" class="btn btn-outline-dark">
        All
    </a>

    <a href="/Staff/RestaurantOverview?status=Ordered" class="btn btn-outline-secondary">
        Ordered
    </a>

    <a href="/Staff/RestaurantOverview?status=BeingPrepared" class="btn btn-outline-warning">
        Being Prepared
    </a>

    <a href="/Staff/RestaurantOverview?status=ReadyToBeServed" class="btn btn-outline-success">
        Ready To Be Served
    </a>
</div>

<br />
<br />

<a href="/Staff/RestaurantOverview">Refresh</a>

<br />
<br />

@if (Model.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Table Number</th>
                <th>Status</th>
                <th>Order Detail</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.TableNumber</td>
                    <td>
                        @if (order.Status == OrderStatus.Ordered)
                        {
                            <span>Ordered</span>
                        }
                        else if (order.Status == OrderStatus.BeingPrepared)
                        {
                            <span>Being Prepared</span>
                        }
                        else if (order.Status == OrderStatus.ReadyToBeServed)
                        {
                            <span>Ready To Be Served</span>
                        }
                    </td>
                    <td>
                        <a href="/">
                            <button type="button">details</button>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

