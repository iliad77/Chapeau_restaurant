@model Chapeau.Models.VeiwModels.TableOrderViewModel

@{
    ViewData["Title"] = "Bill Overview";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container mt-4">
    <h2>Checkout - Table @Model.BoothId</h2>
    <hr />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Qty</th>
                <th>Item</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GroupedItems)
            {
                <tr>
                    <td>@item.Quantity x</td>
                    <td>@item.ItemName</td>
                    <td>€@item.UnitPrice.ToString("0.00")</td>
                    <td>€@item.SubTotal.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row text-end mt-4">
        <div class="col-12">
            <p>Low VAT (9%): €@Model.TotalVatLow.ToString("0.00")</p>
            <p>High VAT (21%): €@Model.TotalVatHigh.ToString("0.00")</p>
            <h3>Total to Pay: €@Model.TotalPrice.ToString("0.00")</h3>
        </div>
    </div>

    <hr />

    <div class="card mt-4">
        <div class="card-body">
            <h4>Process Payment</h4>

            <form asp-controller="Bill" asp-action="ProcessPayment" method="post">
                <input type="hidden" name="BoothId" value="@Model.BoothId" />
                <input type="hidden" name="CurrentTotal" value="@Model.TotalPrice" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Exact Tip Amount (€)</label>
                        <input type="number" step="0.01" name="TipAmount" class="form-control" placeholder="e.g. 5.00" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>OR Total Handed by Guest (€)</label>
                        <input type="number" step="0.01" name="AmountPaid" class="form-control" placeholder="e.g. 50.00" />
                        <small class="text-muted">Tip will be calculated automatically.</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label>Payment Method</label>
                    <select name="Method" class="form-select" required>
                        <option value="1">Cash</option>
                        <option value="2">Debit Card (PIN)</option>
                        <option value="3">Credit Card</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label>Guest Feedback (Optional)</label>
                    <textarea name="Feedback" class="form-control" rows="2" placeholder="How was the food?"></textarea>
                </div>

                <button type="submit" class="btn btn-success w-100 fs-5">Confirm Payment & Clear Table</button>
            </form>
        </div>
    </div>
</div>