@model List<Chapeau.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";

    string? selectedMenu = Context.Request.Query["menuName"];
    string? selectedCategory = Context.Request.Query["category"];
}

<div class="text-center">
    <h1 class="display-4">Menu</h1>
</div>

<p>
    <a asp-controller="Menu" asp-action="Index">All</a> |

    <a asp-controller="Menu" asp-action="Index" asp-route-menuName="Dinner">Dinner</a> |
    <a asp-controller="Menu" asp-action="Index" asp-route-menuName="Lunch">Lunch</a> |

    <a asp-controller="Menu" asp-action="Index" asp-route-category="0">Starter</a> |
    <a asp-controller="Menu" asp-action="Index" asp-route-category="1">Main</a> |
    <a asp-controller="Menu" asp-action="Index" asp-route-category="2">Dessert</a> |
    <a asp-controller="Menu" asp-action="Index" asp-route-category="3">Drink</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @{
            foreach (var item in Model)
            {
                var rowStyle = "";

                if (item.Stock == 0)
                {
                    rowStyle = "class=table-danger";
                }
                else if (item.Stock <= 10)
                {
                    rowStyle = "class=table-warning";
                }
                else
                {
                    rowStyle = "class=table-success";
                }

                <tr @rowStyle>
                    <td>@item.Name</td>
                    <td>€@item.Price</td>

                    <td>
                        @if (item.Stock == 0)
                        {
                            <span>Out of stock</span>
                        }
                        else if (item.Stock <= 10)
                        {
                            <span>Almost out</span>
                        }
                        else
                        {
                            <span>Available</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>